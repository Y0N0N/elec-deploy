{
  "project_dir": ".",
  "data_dir": "../data",
  "model_dir": "./models",
  "upload_dir": "./upload",
  "active_model": "v9.1",
  "model_registry": {
    "v9.1": {
      "label": "v9.1 direction model with volatility filter",
      "pattern": "xgb_v9.1_{ts}.joblib",
      "predict_mode": "spread",
      "trigger_rule": "value_driven"
    },
    "v9": {
      "label": "v9 direction and magnitude model",
      "pattern": "xgb_v9_{ts}.joblib",
      "predict_mode": "spread",
      "trigger_rule": "value_driven"
    },
    "v8.1": {
      "label": "v8.1 spread model",
      "pattern": "xgb_v8.1_{ts}.joblib",
      "predict_mode": "spread",
      "trigger_rule": "value_driven"
    },
    "v7": {
      "label": "v7 spread model",
      "pattern": "xgb_v7.joblib",
      "predict_mode": "spread",
      "trigger_rule": "class"
    }
  },
  "spread": {
    "threshold": 50.0,
    "threshold_big": 100.0
  },
  "predict_window": {
    "back_days": 4,
    "fwd_days": 1
  },
  "factor_rebuild": {
    "mode": "full",
    "tail_days": 60,
    "rebuild_sp_wow": true
  },
  "training": {
    "valid_days": 30,
    "n_estimators": 200,
    "early_stopping": 30,
    "random_state": 42,
    "fixed_params": {
      "max_depth": 8,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 1.0,
      "tree_method": "hist",
      "n_jobs": 8
    }
  }
}
